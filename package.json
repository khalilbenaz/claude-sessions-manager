{
  "name": "claude-sessions-manager",
  "version": "3.0.0",
  "description": "Une fenêtre pour piloter plusieurs sessions Claude Code (Windows & macOS) : sessions persistantes, état en direct, historique, reprise automatique.",
  "bin": {
    "csm": "bin/csm.js"
  },
  "main": "electron/main.js",
  "files": [
    "bin/",
    "lib/",
    "public/",
    "scripts/",
    "electron/",
    "server.js",
    "hook.js",
    "pick-folder.ps1",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "node server.js",
    "app": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "sessions"
  ],
  "author": "Khalil Benazzouz",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "Claude Sessions",
  "build": {
    "appId": "com.claude-sessions.app",
    "productName": "Claude Sessions",
    "copyright": "Khalil Benazzouz",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "bin/**",
      "lib/**",
      "public/**",
      "scripts/**",
      "electron/**",
      "server.js",
      "hook.js",
      "pick-folder.ps1",
      "package.json",
      "!**/*.pdb",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "Claude-Sessions-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Sessions",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Claude-Sessions-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Claude Sessions ${version}"
    }
  },
  "homepage": "https://khalilbenaz.github.io/claude-sessions-manager/",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalilbenaz/claude-sessions-manager.git"
  },
  "bugs": {
    "url": "https://github.com/khalilbenaz/claude-sessions-manager/issues"
  }
}
